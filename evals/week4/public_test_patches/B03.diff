diff --git a/tests/task_verification/test_b03.py b/tests/task_verification/test_b03.py
new file mode 100644
--- /dev/null
+++ b/tests/task_verification/test_b03.py
@@ -0,0 +1,13 @@
+from src.billing.retries import load_invoice_retry_policy
+
+
+def test_invoice_retry_section_controls_attempts(tmp_path, monkeypatch) -> None:
+    configs = tmp_path / "configs"
+    configs.mkdir()
+    (configs / "retry_policy.toml").write_text(
+        "[invoice_retry]\nmax_attempts = 9\n",
+        encoding="utf-8",
+    )
+    monkeypatch.chdir(tmp_path)
+
+    assert load_invoice_retry_policy().max_attempts == 9
