+"""Payment provider gateway."""
 
+import time
+
+from src.billing.retries import InvoiceRetryPolicy, RetryExecutor, RetryPolicyProvider
 from vendor.third_party_payment import ProviderClient
 
 
 class PaymentGateway:
-    """Wraps the vendored provider client."""
+    """Facade over the payment provider."""
 
-    def __init__(self, client: ProviderClient | None = None) -> None:
+    def __init__(
+        self,
+        client: ProviderClient | None = None,
+        executor: RetryExecutor | None = None,
+        policy_provider: RetryPolicyProvider | None = None,
+    ) -> None:
         self.client = client or ProviderClient()
+        self.executor = executor
+        self.policy_provider = policy_provider
 
     def verify_signature(self, payload: bytes, signature: str) -> bool:
         return self.client.verify(payload, signature)
 
     def charge(self, customer_id: str, cents: int) -> dict:
-        return self.client.charge(customer_id, cents)
+        if self.executor is None:
+            return self.client.charge(customer_id, cents)
+
+        invoice = {"customer_id": customer_id, "cents": cents}
+        policy = self.policy_provider.get_policy(invoice)
+        return self._execute_with_retries(invoice, policy)
 
+    def _execute_with_retries(self, invoice: dict, policy: InvoiceRetryPolicy) -> dict:
+        delay = policy.initial_delay_seconds
+        for attempt in range(policy.max_attempts):
+            try:
+                return self.executor.execute(invoice)
+            except Exception:
+                if attempt == policy.max_attempts - 1:
+                    raise
+                time.sleep(delay)
+                delay *= policy.backoff_multiplier
