diff --git a/src/common/settings.py b/src/common/settings.py
index 9da8c11..702a1de 100644
--- a/src/common/settings.py
+++ b/src/common/settings.py
@@ -10,3 +10,41 @@ def config_path(name: str) -> Path:
 def load_retry_policy() -> dict:
     return {"initial_delay_seconds": 30, "max_attempts": 5}
 
+
+def load_feature_flag(section: str, flag: str) -> bool | None:
+    """Read a boolean feature flag from configs/feature_flags.yaml.
+
+    Returns None when the file, section, or flag is missing so callers can
+    preserve their default behavior.
+    """
+    path = config_path("feature_flags.yaml")
+    if not path.exists():
+        return None
+
+    current_section: str | None = None
+    for raw_line in path.read_text(encoding="utf-8").splitlines():
+        line = raw_line.rstrip()
+        if not line.strip() or line.lstrip().startswith("#"):
+            continue
+
+        indent = len(line) - len(line.lstrip())
+        stripped = line.strip()
+
+        if indent == 0 and stripped.endswith(":"):
+            current_section = stripped[:-1].strip()
+            continue
+
+        if indent > 0 and current_section == section:
+            key, _, value = stripped.partition(":")
+            if key.strip() == flag:
+                return _parse_bool(value.strip())
+
+    return None
+
+
+def _parse_bool(value: str) -> bool | None:
+    if value.lower() in ("true", "yes", "on"):
+        return True
+    if value.lower() in ("false", "no", "off"):
+        return False
+    return None
