diff --git a/src/common/settings.py b/src/common/settings.py
index 9da8c11..309ca07 100644
--- a/src/common/settings.py
+++ b/src/common/settings.py
@@ -10,3 +10,61 @@ def config_path(name: str) -> Path:
 def load_retry_policy() -> dict:
     return {"initial_delay_seconds": 30, "max_attempts": 5}
 
+
+def load_feature_flags() -> dict:
+    """Load feature flags from configs/feature_flags.yaml.
+
+    Returns a nested dict keyed by section name. Missing files or
+    malformed content yield an empty dict so callers can fall back to
+    their default behavior.
+    """
+    path = config_path("feature_flags.yaml")
+    if not path.exists():
+        return {}
+
+    flags: dict = {}
+    current_section: str | None = None
+    try:
+        lines = path.read_text(encoding="utf-8").splitlines()
+    except OSError:
+        return {}
+
+    for raw_line in lines:
+        line = raw_line.strip()
+        if not line or line.startswith("#"):
+            continue
+        if line.endswith(":"):
+            current_section = line[:-1].strip()
+            flags.setdefault(current_section, {})
+            continue
+        if ":" in line and current_section is not None:
+            key, _, value = line.partition(":")
+            key = key.strip()
+            value = value.strip()
+            flags[current_section][key] = _parse_scalar(value)
+
+    return flags
+
+
+def _parse_scalar(value: str):
+    """Parse a simple YAML scalar value."""
+    if value == "":
+        return None
+    lowered = value.lower()
+    if lowered == "true":
+        return True
+    if lowered == "false":
+        return False
+    if lowered in ("null", "~"):
+        return None
+    try:
+        return int(value)
+    except ValueError:
+        pass
+    try:
+        return float(value)
+    except ValueError:
+        pass
+    if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
+        return value[1:-1]
+    return value
diff --git a/src/notifications/dispatcher.py b/src/notifications/dispatcher.py
index 36d4e13..d77b414 100644
--- a/src/notifications/dispatcher.py
+++ b/src/notifications/dispatcher.py
@@ -1,6 +1,7 @@
 """Event-driven notification dispatch."""
 
 from src.common.events import EventEnvelope, INVOICE_RETRY_REQUESTED, ORDER_CANCELLED
+from src.common.settings import load_feature_flags
 from src.notifications.email import EmailSender
 from src.notifications.templates import TEMPLATE_INVOICE_RETRY, TEMPLATE_ORDER_CANCELLED
 
@@ -12,8 +13,19 @@ class NotificationDispatcher:
         self.sender = sender or EmailSender()
 
     def handle(self, event: EventEnvelope) -> None:
+        if not self._email_dispatch_enabled():
+            return
         if event.name == ORDER_CANCELLED:
             self.sender.send("ops@example.com", TEMPLATE_ORDER_CANCELLED, event.payload)
         if event.name == INVOICE_RETRY_REQUESTED:
             self.sender.send("billing@example.com", TEMPLATE_INVOICE_RETRY, event.payload)
 
+    def _email_dispatch_enabled(self) -> bool:
+        flags = load_feature_flags()
+        notifications = flags.get("notifications")
+        if not isinstance(notifications, dict):
+            return True
+        value = notifications.get("email_dispatch_enabled")
+        if value is None:
+            return True
+        return value is not False
