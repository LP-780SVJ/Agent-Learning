 """Payment provider abstraction."""
 
+import time
+
 from vendor.third_party_payment import ProviderClient
 
+from src.billing.retries import (
+    InvoiceRetryPolicy,
+    RetryExecutor,
+    RetryPolicyProvider,
+    load_invoice_retry_policy,
+)
+
+
+class _ClientExecutor:
+    """Default executor that delegates to the vendored provider client."""
+
+    def __init__(self, client: ProviderClient) -> None:
+        self.client = client
+
+    def execute(self, invoice: dict) -> dict:
+        return self.client.charge(invoice["customer_id"], invoice["cents"])
+
+
+class _DefaultPolicyProvider:
+    """Default policy provider using the configured invoice retry policy."""
+
+    def get_policy(self, invoice: dict) -> InvoiceRetryPolicy:
+        return load_invoice_retry_policy()
+
 
 class PaymentGateway:
     """Wraps the vendored provider client."""
 
-    def __init__(self, client: ProviderClient | None = None) -> None:
+    def __init__(
+        self,
+        client: ProviderClient | None = None,
+        executor: RetryExecutor | None = None,
+        policy_provider: RetryPolicyProvider | None = None,
+    ) -> None:
         self.client = client or ProviderClient()
+        self.executor = executor or _ClientExecutor(self.client)
+        self.policy_provider = policy_provider or _DefaultPolicyProvider()
 
     def verify_signature(self, payload: bytes, signature: str) -> bool:
         return self.client.verify(payload, signature)
 
     def charge(self, customer_id: str, cents: int) -> dict:
-        return self.client.charge(customer_id, cents)
+        invoice = {"customer_id": customer_id, "cents": cents}
+        policy = self.policy_provider.get_policy(invoice)
+
+        last_error: Exception | None = None
+        for attempt in range(policy.max_attempts):
+            try:
+                return self.executor.execute(invoice)
+            except Exception as exc:  # noqa: BLE001 - retry any provider failure
+                last_error = exc
+                if attempt < policy.max_attempts - 1:
+                    delay = policy.initial_delay_seconds * (
+                        policy.backoff_multiplier ** attempt
+                    )
+                    time.sleep(delay)
 
+        assert last_error is not None
+        raise last_error
