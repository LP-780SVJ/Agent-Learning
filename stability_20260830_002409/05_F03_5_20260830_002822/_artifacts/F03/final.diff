diff --git a/src/common/settings.py b/src/common/settings.py
index 9da8c11..cba86ce 100644
--- a/src/common/settings.py
+++ b/src/common/settings.py
@@ -10,3 +10,63 @@ def config_path(name: str) -> Path:
 def load_retry_policy() -> dict:
     return {"initial_delay_seconds": 30, "max_attempts": 5}
 
+
+def load_feature_flags() -> dict:
+    """Load feature flags from configs/feature_flags.yaml.
+
+    Returns an empty dict when the file is missing or unreadable so that
+    callers can fall back to their default behavior.
+    """
+    path = config_path("feature_flags.yaml")
+    if not path.exists():
+        return {}
+    return _parse_simple_yaml(path.read_text(encoding="utf-8"))
+
+
+def _parse_simple_yaml(text: str) -> dict:
+    """Parse the simple nested key/value YAML used by feature_flags.yaml.
+
+    Only supports scalar values (booleans, numbers, strings) and nested
+    mappings expressed via indentation. This avoids a hard dependency on a
+    third-party YAML library.
+    """
+    result: dict = {}
+    stack: list[tuple[int, dict]] = [(-1, result)]
+    for raw_line in text.splitlines():
+        line = raw_line.rstrip()
+        if not line.strip() or line.lstrip().startswith("#"):
+            continue
+        indent = len(line) - len(line.lstrip())
+        key, _, value = line.strip().partition(":")
+        key = key.strip()
+        value = value.strip()
+        while stack and indent <= stack[-1][0]:
+            stack.pop()
+        parent = stack[-1][1]
+        if value == "":
+            child: dict = {}
+            parent[key] = child
+            stack.append((indent, child))
+        else:
+            parent[key] = _parse_scalar(value)
+    return result
+
+
+def _parse_scalar(value: str) -> object:
+    if value == "true":
+        return True
+    if value == "false":
+        return False
+    if value == "null" or value == "~":
+        return None
+    try:
+        return int(value)
+    except ValueError:
+        pass
+    try:
+        return float(value)
+    except ValueError:
+        pass
+    if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
+        return value[1:-1]
+    return value
