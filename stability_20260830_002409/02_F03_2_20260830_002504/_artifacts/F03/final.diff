diff --git a/src/common/settings.py b/src/common/settings.py
index 9da8c11..cc47565 100644
--- a/src/common/settings.py
+++ b/src/common/settings.py
@@ -10,3 +10,49 @@ def config_path(name: str) -> Path:
 def load_retry_policy() -> dict:
     return {"initial_delay_seconds": 30, "max_attempts": 5}
 
+
+def _parse_scalar(value: str):
+    """Parse a simple YAML scalar value."""
+    if value == "true":
+        return True
+    if value == "false":
+        return False
+    if value in ("null", "~", ""):
+        return None
+    try:
+        return int(value)
+    except ValueError:
+        pass
+    try:
+        return float(value)
+    except ValueError:
+        pass
+    return value
+
+
+def load_feature_flags() -> dict:
+    """Load feature flags from configs/feature_flags.yaml.
+
+    Returns a nested dict keyed by section and flag name. Returns an empty
+    dict when the file is missing or unreadable.
+    """
+    path = config_path("feature_flags.yaml")
+    if not path.exists():
+        return {}
+
+    flags: dict = {}
+    current_section: str | None = None
+    for raw_line in path.read_text(encoding="utf-8").splitlines():
+        line = raw_line.rstrip()
+        stripped = line.strip()
+        if not stripped or stripped.startswith("#"):
+            continue
+        if not line.startswith((" ", "\t")):
+            current_section = stripped.rstrip(":").strip()
+            flags.setdefault(current_section, {})
+            continue
+        key, sep, value = stripped.partition(":")
+        if not sep or current_section is None:
+            continue
+        flags[current_section][key.strip()] = _parse_scalar(value.strip())
+    return flags
