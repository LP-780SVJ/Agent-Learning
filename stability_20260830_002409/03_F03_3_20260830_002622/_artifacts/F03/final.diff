diff --git a/src/common/settings.py b/src/common/settings.py
index 9da8c11..7782ff0 100644
--- a/src/common/settings.py
+++ b/src/common/settings.py
@@ -10,3 +10,62 @@ def config_path(name: str) -> Path:
 def load_retry_policy() -> dict:
     return {"initial_delay_seconds": 30, "max_attempts": 5}
 
+
+def _parse_scalar(value: str):
+    value = value.strip()
+    if value == "true":
+        return True
+    if value == "false":
+        return False
+    if value == "null" or value == "~":
+        return None
+    try:
+        return int(value)
+    except ValueError:
+        pass
+    try:
+        return float(value)
+    except ValueError:
+        pass
+    if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
+        return value[1:-1]
+    return value
+
+
+def load_feature_flags() -> dict:
+    """Load feature flags from configs/feature_flags.yaml.
+
+    Returns an empty dict when the file is missing or unreadable so that
+    callers can fall back to their default behavior.
+    """
+    path = config_path("feature_flags.yaml")
+    try:
+        text = path.read_text(encoding="utf-8")
+    except OSError:
+        return {}
+
+    root: dict = {}
+    stack: list[tuple[int, dict]] = [(-1, root)]
+    for raw_line in text.splitlines():
+        if not raw_line.strip() or raw_line.lstrip().startswith("#"):
+            continue
+        indent = len(raw_line) - len(raw_line.lstrip(" "))
+        line = raw_line.strip()
+        if ":" not in line:
+            continue
+        key, _, value = line.partition(":")
+        key = key.strip()
+        value = value.strip()
+
+        while stack and indent <= stack[-1][0]:
+            stack.pop()
+        parent = stack[-1][1]
+
+        if value:
+            parent[key] = _parse_scalar(value)
+        else:
+            child: dict = {}
+            parent[key] = child
+            stack.append((indent, child))
+
+    return root
