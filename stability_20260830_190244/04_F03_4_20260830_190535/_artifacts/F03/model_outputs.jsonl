{"step": 12, "raw_content": "Now I'll implement the solution. I'll add a `load_feature_flags` helper to `src/common/settings.py` that parses the YAML file, and use it in the dispatcher.\n\nThe YAML structure is simple: sections with `key: value` entries. I'll write a minimal parser that handles this flat structure (sections and scalar values), which is sufficient for the project's config files.", "native_tool_calls": [{"call_id": "step-12-call-1", "provider_call_id": "call_00_wisd8PPbE5h2ZqAmm1T26705", "name": "apply_patch", "arguments": {"edits": [{"path": "src/common/settings.py", "content": "\"\"\"Configuration loading helpers.\"\"\"\n\nfrom pathlib import Path\n\n\ndef config_path(name: str) -> Path:\n    return Path(\"configs\") / name\n\n\ndef load_retry_policy() -> dict:\n    return {\"initial_delay_seconds\": 30, \"max_attempts\": 5}\n\n\ndef load_feature_flags() -> dict:\n    \"\"\"Load feature flags from configs/feature_flags.yaml.\n\n    Returns a nested dict keyed by section name. Missing files or sections\n    simply yield an empty mapping so callers can fall back to defaults.\n    \"\"\"\n    path = config_path(\"feature_flags.yaml\")\n    if not path.exists():\n        return {}\n\n    flags: dict = {}\n    current_section: str | None = None\n    for raw_line in path.read_text(encoding=\"utf-8\").splitlines():\n        line = raw_line.strip()\n        if not line or line.startswith(\"#\"):\n            continue\n        if line.endswith(\":\"):\n            current_section = line[:-1].strip()\n            flags.setdefault(current_section, {})\n            continue\n        if \":\" in line and current_section is not None:\n            key, _, value = line.partition(\":\")\n            flags[current_section][key.strip()] = _parse_scalar(value.strip())\n    return flags\n\n\ndef _parse_scalar(value: str) -> object:\n    if value in (\"true\", \"True\"):\n        return True\n    if value in (\"false\", \"False\"):\n        return False\n    if value in (\"null\", \"~\", \"\"):\n        return None\n    try:\n        return int(value)\n    except ValueError:\n        pass\n    try:\n        return float(value)\n    except ValueError:\n        pass\n    return value\n"}]}}], "dialect": null, "canonical_payload": {"tool_calls": [{"name": "apply_patch", "arguments": {"edits": [{"path": "src/common/settings.py", "content": "\"\"\"Configuration loading helpers.\"\"\"\n\nfrom pathlib import Path\n\n\ndef config_path(name: str) -> Path:\n    return Path(\"configs\") / name\n\n\ndef load_retry_policy() -> dict:\n    return {\"initial_delay_seconds\": 30, \"max_attempts\": 5}\n\n\ndef load_feature_flags() -> dict:\n    \"\"\"Load feature flags from configs/feature_flags.yaml.\n\n    Returns a nested dict keyed by section name. Missing files or sections\n    simply yield an empty mapping so callers can fall back to defaults.\n    \"\"\"\n    path = config_path(\"feature_flags.yaml\")\n    if not path.exists():\n        return {}\n\n    flags: dict = {}\n    current_section: str | None = None\n    for raw_line in path.read_text(encoding=\"utf-8\").splitlines():\n        line = raw_line.strip()\n        if not line or line.startswith(\"#\"):\n            continue\n        if line.endswith(\":\"):\n            current_section = line[:-1].strip()\n            flags.setdefault(current_section, {})\n            continue\n        if \":\" in line and current_section is not None:\n            key, _, value = line.partition(\":\")\n            flags[current_section][key.strip()] = _parse_scalar(value.strip())\n    return flags\n\n\ndef _parse_scalar(value: str) -> object:\n    if value in (\"true\", \"True\"):\n        return True\n    if value in (\"false\", \"False\"):\n        return False\n    if value in (\"null\", \"~\", \"\"):\n        return None\n    try:\n        return int(value)\n    except ValueError:\n        pass\n    try:\n        return float(value)\n    except ValueError:\n        pass\n    return value\n"}]}, "runtime_call_id": "step-12-call-1", "provider_call_id": "call_00_wisd8PPbE5h2ZqAmm1T26705"}]}, "parse_error": null, "model": "deepseek-v4-pro", "provider": "openai-compatible", "response_id": "21641f77-8fa1-45fc-a12e-94c42b86bdb5", "finish_state": "tool_calls", "finish_reason": "tool_calls", "actual_response_mode": "native_tools", "incomplete_reason": null, "system_fingerprint": "a307abda487cd1b463329ccb945ce396", "input_tokens": 7417, "output_tokens": 596}
{"step": 13, "raw_content": "", "native_tool_calls": [{"call_id": "step-13-call-1", "provider_call_id": "call_00_BbrSlPqMSplUXxoHz7QQ7200", "name": "apply_patch", "arguments": {"edits": [{"path": "src/notifications/dispatcher.py", "content": "\"\"\"Event-driven notification dispatch.\"\"\"\n\nfrom src.common.events import EventEnvelope, INVOICE_RETRY_REQUESTED, ORDER_CANCELLED\nfrom src.common.settings import load_feature_flags\nfrom src.notifications.email import EmailSender\nfrom src.notifications.templates import TEMPLATE_INVOICE_RETRY, TEMPLATE_ORDER_CANCELLED\n\n\nclass NotificationDispatcher:\n    \"\"\"Routes events to email templates.\"\"\"\n\n    def __init__(self, sender: EmailSender | None = None) -> None:\n        self.sender = sender or EmailSender()\n\n    def _email_dispatch_enabled(self) -> bool:\n        flags = load_feature_flags()\n        notifications = flags.get(\"notifications\", {})\n        if not isinstance(notifications, dict):\n            return True\n        flag = notifications.get(\"email_dispatch_enabled\")\n        # Dispatch is suppressed only when the flag is explicitly false.\n        return flag is not False\n\n    def handle(self, event: EventEnvelope) -> None:\n        if not self._email_dispatch_enabled():\n            return\n        if event.name == ORDER_CANCELLED:\n            self.sender.send(\"ops@example.com\", TEMPLATE_ORDER_CANCELLED, event.payload)\n        if event.name == INVOICE_RETRY_REQUESTED:\n            self.sender.send(\"billing@example.com\", TEMPLATE_INVOICE_RETRY, event.payload)\n"}]}}], "dialect": null, "canonical_payload": {"tool_calls": [{"name": "apply_patch", "arguments": {"edits": [{"path": "src/notifications/dispatcher.py", "content": "\"\"\"Event-driven notification dispatch.\"\"\"\n\nfrom src.common.events import EventEnvelope, INVOICE_RETRY_REQUESTED, ORDER_CANCELLED\nfrom src.common.settings import load_feature_flags\nfrom src.notifications.email import EmailSender\nfrom src.notifications.templates import TEMPLATE_INVOICE_RETRY, TEMPLATE_ORDER_CANCELLED\n\n\nclass NotificationDispatcher:\n    \"\"\"Routes events to email templates.\"\"\"\n\n    def __init__(self, sender: EmailSender | None = None) -> None:\n        self.sender = sender or EmailSender()\n\n    def _email_dispatch_enabled(self) -> bool:\n        flags = load_feature_flags()\n        notifications = flags.get(\"notifications\", {})\n        if not isinstance(notifications, dict):\n            return True\n        flag = notifications.get(\"email_dispatch_enabled\")\n        # Dispatch is suppressed only when the flag is explicitly false.\n        return flag is not False\n\n    def handle(self, event: EventEnvelope) -> None:\n        if not self._email_dispatch_enabled():\n            return\n        if event.name == ORDER_CANCELLED:\n            self.sender.send(\"ops@example.com\", TEMPLATE_ORDER_CANCELLED, event.payload)\n        if event.name == INVOICE_RETRY_REQUESTED:\n            self.sender.send(\"billing@example.com\", TEMPLATE_INVOICE_RETRY, event.payload)\n"}]}, "runtime_call_id": "step-13-call-1", "provider_call_id": "call_00_BbrSlPqMSplUXxoHz7QQ7200"}]}, "parse_error": null, "model": "deepseek-v4-pro", "provider": "openai-compatible", "response_id": "9436d3eb-8044-4a87-b8ca-249d804ba586", "finish_state": "tool_calls", "finish_reason": "tool_calls", "actual_response_mode": "native_tools", "incomplete_reason": null, "system_fingerprint": "a307abda487cd1b463329ccb945ce396", "input_tokens": 7310, "output_tokens": 408}
