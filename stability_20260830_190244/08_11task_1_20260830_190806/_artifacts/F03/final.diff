diff --git a/src/common/settings.py b/src/common/settings.py
index 9da8c11..4d9333f 100644
--- a/src/common/settings.py
+++ b/src/common/settings.py
@@ -10,3 +10,70 @@ def config_path(name: str) -> Path:
 def load_retry_policy() -> dict:
     return {"initial_delay_seconds": 30, "max_attempts": 5}
 
+
+def _parse_scalar(value: str):
+    value = value.strip()
+    if value == "true":
+        return True
+    if value == "false":
+        return False
+    if value == "null" or value == "~":
+        return None
+    if (value.startswith('"') and value.endswith('"')) or (
+        value.startswith("'") and value.endswith("'")
+    ):
+        return value[1:-1]
+    try:
+        return int(value)
+    except ValueError:
+        pass
+    try:
+        return float(value)
+    except ValueError:
+        pass
+    return value
+
+
+def _parse_yaml_mapping(text: str) -> dict:
+    """Parse a minimal subset of YAML: nested mappings with scalar values."""
+    result: dict = {}
+    stack: list[tuple[int, dict]] = []
+    for raw_line in text.splitlines():
+        if not raw_line.strip() or raw_line.lstrip().startswith("#"):
+            continue
+        indent = len(raw_line) - len(raw_line.lstrip(" \t"))
+        line = raw_line.strip()
+        if ":" not in line:
+            continue
+        key, _, value = line.partition(":")
+        key = key.strip()
+        value = value.strip()
+        while stack and stack[-1][0] >= indent:
+            stack.pop()
+        if value == "":
+            child: dict = {}
+            if stack:
+                stack[-1][1][key] = child
+            else:
+                result[key] = child
+            stack.append((indent, child))
+        else:
+            parsed = _parse_scalar(value)
+            if stack:
+                stack[-1][1][key] = parsed
+            else:
+                result[key] = parsed
+    return result
+
+
+def load_feature_flags() -> dict:
+    """Load feature flags from configs/feature_flags.yaml.
+
+    Returns an empty dict when the file is missing or unreadable.
+    """
+    path = config_path("feature_flags.yaml")
+    try:
+        text = path.read_text(encoding="utf-8")
+    except OSError:
+        return {}
+    return _parse_yaml_mapping(text)
