diff --git a/src/common/settings.py b/src/common/settings.py
index 9da8c11..ea66f65 100644
--- a/src/common/settings.py
+++ b/src/common/settings.py
@@ -10,3 +10,34 @@ def config_path(name: str) -> Path:
 def load_retry_policy() -> dict:
     return {"initial_delay_seconds": 30, "max_attempts": 5}
 
+
+def load_feature_flag(section: str, flag: str) -> bool | None:
+    """Read a boolean feature flag from configs/feature_flags.yaml.
+
+    Returns None when the file, section, or flag is missing so callers can
+    preserve their default behavior.
+    """
+    path = config_path("feature_flags.yaml")
+    if not path.exists():
+        return None
+
+    current_section: str | None = None
+    for raw_line in path.read_text(encoding="utf-8").splitlines():
+        line = raw_line.strip()
+        if not line or line.startswith("#"):
+            continue
+        if line.endswith(":"):
+            current_section = line[:-1].strip()
+            continue
+        if ":" not in line:
+            continue
+        key, _, value = line.partition(":")
+        key = key.strip()
+        value = value.strip()
+        if current_section == section and key == flag:
+            if value.lower() == "false":
+                return False
+            if value.lower() == "true":
+                return True
+            return None
+    return None
