diff --git a/src/common/settings.py b/src/common/settings.py
index 9da8c11..eae3897 100644
--- a/src/common/settings.py
+++ b/src/common/settings.py
@@ -10,3 +10,55 @@ def config_path(name: str) -> Path:
 def load_retry_policy() -> dict:
     return {"initial_delay_seconds": 30, "max_attempts": 5}
 
+
+def _parse_yaml_scalar(value: str):
+    """Parse a simple YAML scalar value."""
+    if value == "":
+        return None
+    lowered = value.lower()
+    if lowered == "true":
+        return True
+    if lowered == "false":
+        return False
+    if lowered in ("null", "~"):
+        return None
+    try:
+        return int(value)
+    except ValueError:
+        pass
+    try:
+        return float(value)
+    except ValueError:
+        pass
+    return value
+
+
+def load_feature_flags() -> dict:
+    """Load feature flags from configs/feature_flags.yaml.
+
+    Returns a nested dict keyed by section then flag. A missing file yields an
+    empty dict, so callers can fall back to their default behavior.
+    """
+    path = config_path("feature_flags.yaml")
+    if not path.exists():
+        return {}
+
+    flags: dict = {}
+    section: str | None = None
+    for raw in path.read_text(encoding="utf-8").splitlines():
+        line = raw.rstrip("\n")
+        stripped = line.strip()
+        if not stripped or stripped.startswith("#"):
+            continue
+        indent = len(line) - len(line.lstrip(" "))
+        key, sep, value = stripped.partition(":")
+        if not sep:
+            continue
+        key = key.strip()
+        value = value.strip()
+        if indent == 0:
+            section = key
+            flags[section] = {}
+        elif section is not None:
+            flags[section][key] = _parse_yaml_scalar(value)
+    return flags
