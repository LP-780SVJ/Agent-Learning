diff --git a/src/common/settings.py b/src/common/settings.py
index 9da8c11..96b9793 100644
--- a/src/common/settings.py
+++ b/src/common/settings.py
@@ -10,3 +10,45 @@ def config_path(name: str) -> Path:
 def load_retry_policy() -> dict:
     return {"initial_delay_seconds": 30, "max_attempts": 5}
 
+
+def _parse_simple_yaml(text: str) -> dict[str, dict[str, str]]:
+    """Parse a minimal two-level YAML mapping of the form::
+
+        section:
+          flag: value
+
+    Values are returned as raw strings.
+    """
+    sections: dict[str, dict[str, str]] = {}
+    current_section: str | None = None
+    for line in text.splitlines():
+        stripped = line.strip()
+        if not stripped or stripped.startswith("#"):
+            continue
+        if line.startswith((" ", "\t")):
+            key, _, value = stripped.partition(":")
+            if current_section is not None:
+                sections.setdefault(current_section, {})[key.strip()] = value.strip()
+        else:
+            key, _, _ = stripped.partition(":")
+            current_section = key.strip()
+            sections.setdefault(current_section, {})
+    return sections
+
+
+def load_feature_flag(section: str, flag: str) -> bool | None:
+    """Read a boolean feature flag from ``configs/feature_flags.yaml``.
+
+    Returns ``None`` when the file, section, or flag is missing so callers can
+    distinguish an explicitly disabled flag from an absent one.
+    """
+    path = config_path("feature_flags.yaml")
+    if not path.exists():
+        return None
+    sections = _parse_simple_yaml(path.read_text(encoding="utf-8"))
+    raw = sections.get(section, {}).get(flag)
+    if raw == "true":
+        return True
+    if raw == "false":
+        return False
+    return None
