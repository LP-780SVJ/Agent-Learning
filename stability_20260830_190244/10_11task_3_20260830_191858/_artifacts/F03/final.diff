diff --git a/src/common/settings.py b/src/common/settings.py
index 9da8c11..31604e8 100644
--- a/src/common/settings.py
+++ b/src/common/settings.py
@@ -10,3 +10,49 @@ def config_path(name: str) -> Path:
 def load_retry_policy() -> dict:
     return {"initial_delay_seconds": 30, "max_attempts": 5}
 
+
+def load_feature_flags() -> dict:
+    """Load feature flags from configs/feature_flags.yaml.
+
+    Returns an empty dict when the file is missing or unreadable.
+    """
+    path = config_path("feature_flags.yaml")
+    try:
+        text = path.read_text(encoding="utf-8")
+    except OSError:
+        return {}
+    return _parse_simple_yaml(text)
+
+
+def _parse_simple_yaml(text: str) -> dict:
+    """Parse a minimal two-level YAML mapping of scalar values.
+
+    This intentionally supports only the flat ``section:`` / ``key: value``
+    shape used by configs/feature_flags.yaml. Anything else is ignored so
+    that missing or unexpected content degrades gracefully.
+    """
+    result: dict = {}
+    current_section: str | None = None
+    for raw_line in text.splitlines():
+        line = raw_line.strip()
+        if not line or line.startswith("#"):
+            continue
+        if line.endswith(":"):
+            current_section = line[:-1].strip()
+            result.setdefault(current_section, {})
+            continue
+        if ":" in line and current_section is not None:
+            key, _, value = line.partition(":")
+            key = key.strip()
+            value = value.strip()
+            section = result.setdefault(current_section, {})
+            section[key] = _parse_scalar(value)
+    return result
+
+
+def _parse_scalar(value: str) -> object:
+    if value == "true":
+        return True
+    if value == "false":
+        return False
+    return value
