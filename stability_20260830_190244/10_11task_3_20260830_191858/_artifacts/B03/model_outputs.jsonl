     \"backoff_multiplier\": 2,\n    }\n\n    path: Path = config_path(\"retry_policy.toml\")\n    if path.exists():\n        with path.open(\"rb\") as file:\n            data = tomllib.load(file)\n        section = data.get(\"invoice_retry\", {})\n        defaults.update(section)\n\n    return InvoiceRetryPolicy(\n        initial_delay_seconds=defaults[\"initial_delay_seconds\"],\n        max_attempts=defaults[\"max_attempts\"],\n        backoff_multiplier=defaults[\"backoff_multiplier\"],\n    )\n"}]}, "runtime_call_id": "step-6-call-1", "provider_call_id": "call_00_Zfm7tAMSddCUH3qge5SC6953"}]}, "parse_error": null, "model": "deepseek-v4-pro", "provider": "openai-compatible", "response_id": "0007db0d-cde3-4db6-bcb9-67e88d6260be", "finish_state": "tool_calls", "finish_reason": "tool_calls", "actual_response_mode": "native_tools", "incomplete_reason": null, "system_fingerprint": "a307abda487cd1b463329ccb945ce396", "input_tokens": 6878, "output_tokens": 407}
