diff --git a/src/common/settings.py b/src/common/settings.py
index 9da8c11..9b66f7b 100644
--- a/src/common/settings.py
+++ b/src/common/settings.py
@@ -10,3 +10,47 @@ def config_path(name: str) -> Path:
 def load_retry_policy() -> dict:
     return {"initial_delay_seconds": 30, "max_attempts": 5}
 
+
+def _parse_yaml_value(raw: str):
+    """Parse a scalar YAML value from a simple feature-flags file."""
+    value = raw.strip()
+    if value == "true":
+        return True
+    if value == "false":
+        return False
+    if value == "null" or value == "~":
+        return None
+    if value.startswith('"') and value.endswith('"'):
+        return value[1:-1]
+    if value.startswith("'") and value.endswith("'"):
+        return value[1:-1]
+    return value
+
+
+def load_feature_flags() -> dict:
+    """Load feature flags from configs/feature_flags.yaml.
+
+    Returns a nested dict keyed by section and flag name. Missing files
+    yield an empty dict so callers can fall back to default behavior.
+    """
+    path = config_path("feature_flags.yaml")
+    if not path.exists():
+        return {}
+
+    flags: dict = {}
+    current_section: str | None = None
+    for line in path.read_text(encoding="utf-8").splitlines():
+        stripped = line.strip()
+        if not stripped or stripped.startswith("#"):
+            continue
+        if not line[0].isspace():
+            # Top-level section header, e.g. "notifications:".
+            current_section = stripped.rstrip(":").strip()
+            flags.setdefault(current_section, {})
+            continue
+        key, sep, value = stripped.partition(":")
+        if not sep:
+            continue
+        if current_section is not None:
+            flags[current_section][key.strip()] = _parse_yaml_value(value)
+    return flags
