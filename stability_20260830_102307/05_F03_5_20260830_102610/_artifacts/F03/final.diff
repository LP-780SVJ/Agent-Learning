diff --git a/src/common/settings.py b/src/common/settings.py
index 9da8c11..9cfce12 100644
--- a/src/common/settings.py
+++ b/src/common/settings.py
@@ -10,3 +10,67 @@ def config_path(name: str) -> Path:
 def load_retry_policy() -> dict:
     return {"initial_delay_seconds": 30, "max_attempts": 5}
 
+
+def _parse_scalar(value: str):
+    value = value.strip()
+    if value == "true":
+        return True
+    if value == "false":
+        return False
+    if value == "null" or value == "~":
+        return None
+    try:
+        return int(value)
+    except ValueError:
+        pass
+    try:
+        return float(value)
+    except ValueError:
+        pass
+    return value
+
+
+def _parse_simple_yaml(text: str) -> dict:
+    """Parse the small subset of YAML used by feature_flags.yaml.
+
+    Supports nested mappings with scalar values and 2-space indentation.
+    """
+    result: dict = {}
+    stack: list[tuple[int, dict]] = []
+    for raw_line in text.splitlines():
+        line = raw_line.rstrip()
+        stripped = line.strip()
+        if not stripped or stripped.startswith("#"):
+            continue
+        indent = len(line) - len(line.lstrip(" "))
+        if stripped.endswith(":"):
+            key = stripped[:-1].strip()
+            child: dict = {}
+            while stack and stack[-1][0] >= indent:
+                stack.pop()
+            if stack:
+                stack[-1][1][key] = child
+            else:
+                result[key] = child
+            stack.append((indent, child))
+        else:
+            key, _, value = stripped.partition(":")
+            key = key.strip()
+            while stack and stack[-1][0] >= indent:
+                stack.pop()
+            target = stack[-1][1] if stack else result
+            target[key] = _parse_scalar(value)
+    return result
+
+
+def load_feature_flags() -> dict:
+    """Load feature flags from configs/feature_flags.yaml.
+
+    Returns an empty dict when the file is missing or unreadable.
+    """
+    path = config_path("feature_flags.yaml")
+    try:
+        text = path.read_text(encoding="utf-8")
+    except OSError:
+        return {}
+    return _parse_simple_yaml(text)
