diff --git a/src/common/settings.py b/src/common/settings.py
index 9da8c11..b161091 100644
--- a/src/common/settings.py
+++ b/src/common/settings.py
@@ -10,3 +10,70 @@ def config_path(name: str) -> Path:
 def load_retry_policy() -> dict:
     return {"initial_delay_seconds": 30, "max_attempts": 5}
 
+
+def _parse_yaml_value(raw: str):
+    """Parse a scalar YAML value (bool, int, float, null, or string)."""
+    value = raw.strip()
+    lowered = value.lower()
+    if lowered == "true":
+        return True
+    if lowered == "false":
+        return False
+    if lowered in ("null", "~", ""):
+        return None
+    try:
+        return int(value)
+    except ValueError:
+        pass
+    try:
+        return float(value)
+    except ValueError:
+        pass
+    return value
+
+
+def load_feature_flags() -> dict:
+    """Load configs/feature_flags.yaml into a nested dict.
+
+    Returns an empty dict when the file is missing or unreadable.
+    """
+    path = config_path("feature_flags.yaml")
+    try:
+        text = path.read_text(encoding="utf-8")
+    except OSError:
+        return {}
+
+    root: dict = {}
+    stack: list[tuple[int, dict]] = [(-1, root)]
+    for line in text.splitlines():
+        stripped = line.strip()
+        if not stripped or stripped.startswith("#"):
+            continue
+        indent = len(line) - len(line.lstrip())
+        if ":" not in stripped:
+            continue
+        key, _, value = stripped.partition(":")
+        key = key.strip()
+        value = value.strip()
+
+        while stack and indent <= stack[-1][0]:
+            stack.pop()
+        parent = stack[-1][1]
+
+        if value:
+            parent[key] = _parse_yaml_value(value)
+        else:
+            child: dict = {}
+            parent[key] = child
+            stack.append((indent, child))
+
+    return root
+
+
+def get_feature_flag(section: str, flag: str):
+    """Return the value of a feature flag, or None when missing."""
+    flags = load_feature_flags()
+    section_value = flags.get(section)
+    if not isinstance(section_value, dict):
+        return None
+    return section_value.get(flag)
