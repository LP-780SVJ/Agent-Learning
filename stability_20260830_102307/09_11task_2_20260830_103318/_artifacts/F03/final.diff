diff --git a/src/common/settings.py b/src/common/settings.py
index 9da8c11..7f56584 100644
--- a/src/common/settings.py
+++ b/src/common/settings.py
@@ -10,3 +10,67 @@ def config_path(name: str) -> Path:
 def load_retry_policy() -> dict:
     return {"initial_delay_seconds": 30, "max_attempts": 5}
 
+
+def _parse_simple_yaml(text: str) -> dict:
+    """Parse a minimal subset of YAML: nested mappings of scalar values.
+
+    This intentionally avoids a third-party YAML dependency. It supports the
+    flat, two-level structure used by ``configs/feature_flags.yaml``.
+    """
+    result: dict = {}
+    current_section: str | None = None
+    for raw_line in text.splitlines():
+        line = raw_line.rstrip()
+        if not line.strip() or line.strip().startswith("#"):
+            continue
+        stripped = line.lstrip()
+        indent = len(line) - len(stripped)
+        if ":" not in stripped:
+            continue
+        key, _, value = stripped.partition(":")
+        key = key.strip()
+        value = value.strip()
+        if indent == 0:
+            current_section = key
+            result.setdefault(key, {})
+        else:
+            section = current_section if current_section is not None else ""
+            result.setdefault(section, {})[key] = _parse_scalar(value)
+    return result
+
+
+def _parse_scalar(value: str):
+    if value == "":
+        return None
+    lowered = value.lower()
+    if lowered == "true":
+        return True
+    if lowered == "false":
+        return False
+    if lowered in ("null", "~"):
+        return None
+    try:
+        return int(value)
+    except ValueError:
+        pass
+    try:
+        return float(value)
+    except ValueError:
+        pass
+    if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
+        return value[1:-1]
+    return value
+
+
+def load_feature_flags() -> dict:
+    """Load feature flags from ``configs/feature_flags.yaml``.
+
+    Returns an empty mapping when the file is missing or unreadable so that
+    callers can fall back to their default behavior.
+    """
+    path = config_path("feature_flags.yaml")
+    try:
+        text = path.read_text(encoding="utf-8")
+    except OSError:
+        return {}
+    return _parse_simple_yaml(text)
