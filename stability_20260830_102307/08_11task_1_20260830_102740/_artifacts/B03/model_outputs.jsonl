retry\", {})\n\n    return InvoiceRetryPolicy(\n        initial_delay_seconds=raw.get(\"initial_delay_seconds\", 30),\n        max_attempts=raw.get(\"max_attempts\", 5),\n        backoff_multiplier=raw.get(\"backoff_multiplier\", 2),\n    )\n"}]}, "runtime_call_id": "step-6-call-1", "provider_call_id": "call_00_GWurCxkyYdvn4dDKEi3J4223"}]}, "parse_error": null, "model": "deepseek-v4-pro", "provider": "openai-compatible", "response_id": "3a8f3621-c662-4c12-b5aa-8087fd6a3cd6", "finish_state": "tool_calls", "finish_reason": "tool_calls", "actual_response_mode": "native_tools", "incomplete_reason": null, "system_fingerprint": "a307abda487cd1b463329ccb945ce396", "input_tokens": 7373, "output_tokens": 391}
