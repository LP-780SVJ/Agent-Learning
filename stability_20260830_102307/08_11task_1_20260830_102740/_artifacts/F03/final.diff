diff --git a/src/common/settings.py b/src/common/settings.py
index 9da8c11..a9e7c90 100644
--- a/src/common/settings.py
+++ b/src/common/settings.py
@@ -10,3 +10,54 @@ def config_path(name: str) -> Path:
 def load_retry_policy() -> dict:
     return {"initial_delay_seconds": 30, "max_attempts": 5}
 
+
+def _parse_simple_yaml(text: str) -> dict:
+    """Parse the simple nested-mapping YAML used by feature_flags.yaml.
+
+    This intentionally supports only the flat ``section:`` / ``key: value``
+    shape used by the project's config files; it is not a general YAML parser.
+    """
+    result: dict = {}
+    stack: list[tuple[int, dict]] = [(-1, result)]
+    for line in text.splitlines():
+        stripped = line.strip()
+        if not stripped or stripped.startswith("#"):
+            continue
+        indent = len(line) - len(line.lstrip())
+        if stripped.endswith(":"):
+            key = stripped[:-1].strip()
+            while stack and stack[-1][0] >= indent:
+                stack.pop()
+            parent = stack[-1][1]
+            section: dict = {}
+            parent[key] = section
+            stack.append((indent, section))
+        else:
+            key, _, value = stripped.partition(":")
+            key = key.strip()
+            value = value.strip()
+            while stack and stack[-1][0] >= indent:
+                stack.pop()
+            parent = stack[-1][1]
+            parent[key] = value
+    return result
+
+
+def email_dispatch_enabled() -> bool:
+    """Return whether email dispatch is enabled.
+
+    Dispatch is suppressed only when ``notifications.email_dispatch_enabled``
+    is explicitly ``false``. A missing file, section, or flag preserves the
+    default (enabled) behavior.
+    """
+    path = config_path("feature_flags.yaml")
+    if not path.exists():
+        return True
+    data = _parse_simple_yaml(path.read_text(encoding="utf-8"))
+    notifications = data.get("notifications")
+    if not isinstance(notifications, dict):
+        return True
+    flag = notifications.get("email_dispatch_enabled")
+    if flag is None:
+        return True
+    return str(flag).strip().lower() != "false"
